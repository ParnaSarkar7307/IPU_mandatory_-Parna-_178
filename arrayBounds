#include <iostream>
#include <stdexcept>
using namespace std;

class SafeArray
{
private:
    int arr[10];

public:
    // Set function
    void set(int index, int value)
    {
        if (index < 0 || index >= 10)
        {
            throw out_of_range("Invalid array index!");
        }

        arr[index] = value;
    }

    // Get function
    int get(int index)
    {
        if (index < 0 || index >= 10)
        {
            throw out_of_range("Invalid array index!");
        }

        return arr[index];
    }
};

int main()
{
    SafeArray a;

    try
    {
        a.set(2, 50);
        a.set(5, 100);

        cout << "Value at index 2: " << a.get(2) << endl;
        cout << "Value at index 5: " << a.get(5) << endl;

        // Invalid index
        cout << a.get(12) << endl;
    }
    catch (out_of_range &e)
    {
        cout << "Exception caught: " << e.what() << endl;
    }

    return 0;
}
